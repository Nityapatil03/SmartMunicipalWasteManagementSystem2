<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_slate_gray">

    <!-- Top Vehicle Selector Chip Group -->
    <HorizontalScrollView
        android:id="@+id/scroll_vehicle_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_vehicles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_truck_402"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Truck #402 (Ward 14)"
                app:chipIcon="@drawable/ic_truck_gps" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_truck_108"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Compactor #108 (Ward 07)"
                app:chipIcon="@drawable/ic_truck_gps" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_truck_205"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recycle Van #205 (Ward 02)"
                app:chipIcon="@drawable/ic_truck_gps" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Top Floating Vehicle Info Header Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_top_info"
        style="@style/Widget.App.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/scroll_vehicle_chips"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/app_logo_description"
                    android:src="@drawable/ic_truck_gps" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_vehicle_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Municipal Garbage Truck #402"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_vehicle_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="🚘 Vehicle No: MH-12-GW-4021"
                        android:textColor="@color/deep_forest_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_vehicle_route"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Route: Ward 14 • Central Market → Green Park"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- LIVE GPS Badge -->
                <TextView
                    android:id="@+id/tv_live_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_in_progress"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="● LIVE GPS"
                    android:textColor="@color/status_in_progress"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="@color/divider_stroke" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_driver_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Driver: Rajesh Kumar • MH-12-GW-4021"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_speed_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24 km/h • 2.4 km left"
                    android:textColor="@color/deep_forest_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_start_location"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🟢 Start: Ward 14 Central Depot"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_destination_location"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="🏁 Dest: Green Park Processing Plant"
                    android:textColor="@color/deep_forest_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Mappls MapmyIndia Container -->
    <RelativeLayout
        android:id="@+id/container_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/card_bottom_eta"
        android:layout_below="@id/card_top_info"
        android:layout_margin="12dp">

        <WebView
            android:id="@+id/web_view_mappls_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Overlay Banner -->
        <TextView
            android:id="@+id/tv_map_overlay_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:background="#EE1E5631"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="🗺️ Mappls MapmyIndia Live Map"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Floating Live GPS Coordinates Pill -->
        <TextView
            android:id="@+id/tv_gps_coords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="8dp"
            android:background="#DD1E5631"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="GPS: 18.5204° N, 73.8567° E"
            android:textColor="@color/white"
            android:textSize="11sp" />
    </RelativeLayout>

    <!-- Bottom ETA & Interactive Actions Overlay Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_bottom_eta"
        style="@style/Widget.App.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ESTIMATED ARRIVAL"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_eta_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15 Mins Away"
                        android:textColor="@color/deep_forest_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_schedule_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_completed"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="On Schedule"
                    android:textColor="@color/status_completed"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Route Progress Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_current_stop"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Current: Central Market Gate 2"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_progress_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="68% Route Complete"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_route"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:progress="68"
                    app:indicatorColor="@color/deep_forest_green"
                    app:trackColor="#E0E0E0"
                    app:trackCornerRadius="4dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/divider_stroke" />

            <!-- Interactive Action Button Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_call_driver"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="4dp"
                    android:text="Call Driver"
                    android:textSize="11sp"
                    app:icon="@drawable/ic_phone"
                    app:iconSize="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_recenter_map"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="4dp"
                    android:text="Recenter"
                    android:textSize="11sp"
                    app:icon="@drawable/ic_navigation_arrow"
                    app:iconSize="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_toggle_live_gps"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1.2"
                    android:paddingHorizontal="4dp"
                    android:text="Pause GPS"
                    android:textSize="11sp"
                    app:icon="@drawable/ic_refresh"
                    app:iconSize="16dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>