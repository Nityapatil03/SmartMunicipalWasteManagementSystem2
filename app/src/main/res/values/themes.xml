<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SmartMunicipalWasteManagementSystem" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/deep_forest_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/emerald_light</item>
        <item name="colorOnPrimaryContainer">@color/deep_forest_green</item>
        <item name="colorSecondary">@color/emerald_primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/bg_slate_gray</item>
        <item name="android:statusBarColor">@color/deep_forest_green</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.SmartMunicipalWasteManagementSystem" parent="Base.Theme.SmartMunicipalWasteManagementSystem" />

    <!-- Card Styles -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/card_surface</item>
    </style>

    <!-- Pill Button Style -->
    <style name="Widget.App.Button.Pill" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/deep_forest_green</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
</resources>